---
const configuredMeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || "";

if (configuredMeasurementId && !/^G-[A-Z0-9]+$/.test(configuredMeasurementId)) {
  throw new Error("PUBLIC_GA4_MEASUREMENT_ID must be a GA4 Measurement ID such as G-XXXXXXXXXX");
}

const measurementId = configuredMeasurementId;
---

{measurementId && (
  <>
    <div
      class="analytics-consent"
      id="analyticsConsent"
      role="dialog"
      aria-modal="true"
      aria-labelledby="analyticsConsentTitle"
      data-ga4-measurement-id={measurementId}
      hidden
    >
      <div class="analytics-consent__body">
        <strong id="analyticsConsentTitle">Analytics choices</strong>
        <p>
          We use Google Analytics only if you accept. It helps us measure which
          campaigns bring useful visits and outbound OLSP clicks. Advertising
          storage and personalisation remain disabled.
        </p>
        <a href="/privacy/">Read the privacy notice</a>
      </div>
      <div class="analytics-consent__actions">
        <button type="button" data-analytics-choice="denied">Necessary only</button>
        <button type="button" class="primary" data-analytics-choice="granted">Accept analytics</button>
      </div>
    </div>

    <script is:inline define:vars={{ measurementId }}>
      (() => {
        const CONSENT_KEY = "pp_analytics_consent_v1";
        const CAMPAIGN_KEYS = ["utm_id", "utm_source", "utm_medium", "utm_campaign", "utm_content"];
        const OLSP_HOSTS = new Set([
          "olspacademy.com",
          "www.olspacademy.com",
          "offers.olspsystem.com",
          "olspfunnels.com",
          "www.olspfunnels.com",
        ]);
        const banner = document.getElementById("analyticsConsent");

        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
        window.gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: "denied",
        });
        window.gtag("set", "ads_data_redaction", true);

        let tagRequested = false;

        function analyticsGranted() {
          return localStorage.getItem(CONSENT_KEY) === "granted";
        }

        function loadGoogleTag() {
          if (tagRequested || !analyticsGranted()) return;
          tagRequested = true;
          const script = document.createElement("script");
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
          script.onload = () => {
            window.gtag("js", new Date());
            window.gtag("config", measurementId, {
              allow_google_signals: false,
              allow_ad_personalization_signals: false,
              send_page_view: true,
            });
          };
          document.head.appendChild(script);
        }

        function applyChoice(choice) {
          const granted = choice === "granted";
          localStorage.setItem(CONSENT_KEY, granted ? "granted" : "denied");
          window.gtag("consent", "update", {
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            analytics_storage: granted ? "granted" : "denied",
          });
          if (banner) banner.hidden = true;
          if (granted) loadGoogleTag();
        }

        const storedChoice = localStorage.getItem(CONSENT_KEY);
        if (storedChoice === "granted") {
          window.gtag("consent", "update", {
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            analytics_storage: "granted",
          });
          loadGoogleTag();
        } else if (storedChoice !== "denied" && banner) {
          banner.hidden = false;
        }

        document.querySelectorAll("[data-analytics-choice]").forEach((button) => {
          button.addEventListener("click", () => applyChoice(button.dataset.analyticsChoice));
        });

        document.querySelectorAll("[data-analytics-settings]").forEach((button) => {
          button.addEventListener("click", () => {
            if (banner) banner.hidden = false;
          });
        });

        document.addEventListener("click", (event) => {
          const anchor = event.target.closest("a[href]");
          if (!anchor) return;

          let destination;
          try {
            destination = new URL(anchor.href, window.location.href);
          } catch {
            return;
          }
          if (!OLSP_HOSTS.has(destination.hostname)) return;

          const landing = new URL(window.location.href);
          for (const key of CAMPAIGN_KEYS) {
            const value = landing.searchParams.get(key);
            if (value && !destination.searchParams.has(key)) {
              destination.searchParams.set(key, value);
            }
          }
          anchor.href = destination.toString();

          if (!analyticsGranted()) return;
          window.gtag("event", "olsp_outbound_click", {
            link_url: destination.toString(),
            link_domain: destination.hostname,
            link_text: (anchor.textContent || "").trim().slice(0, 100),
            action_id: landing.searchParams.get("utm_id") || "unattributed",
            campaign_content: landing.searchParams.get("utm_content") || "unattributed",
            transport_type: "beacon",
          });
        });
      })();
    </script>

    <style>
      .analytics-consent {
        position: fixed;
        z-index: 1000;
        right: 1rem;
        bottom: 1rem;
        left: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        max-width: 900px;
        margin: 0 auto;
        padding: 1rem 1.1rem;
        color: #1e293b;
        background: #fff;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        box-shadow: 0 12px 36px rgba(15, 23, 42, .18);
        font: 15px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      .analytics-consent[hidden] { display: none; }
      .analytics-consent p { margin: .3rem 0; }
      .analytics-consent a { color: #2563eb; }
      .analytics-consent__actions { display: flex; gap: .6rem; flex-shrink: 0; }
      .analytics-consent button {
        padding: .6rem .85rem;
        color: #1e293b;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        cursor: pointer;
      }
      .analytics-consent button.primary { color: #fff; background: #2563eb; border-color: #2563eb; }
      @media (max-width: 700px) {
        .analytics-consent { align-items: stretch; flex-direction: column; }
        .analytics-consent__actions { justify-content: flex-end; flex-wrap: wrap; }
      }
    </style>
  </>
)}
